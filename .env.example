# Sky configuration.
# Copy this file to `.env` at the repo root (or in `backend/`) and edit.
# Every setting is optional; the defaults below are what the app uses.

# --- General -------------------------------------------------------------
FA_APP_NAME=Sky
FA_ENVIRONMENT=development
FA_DEBUG=false
FA_API_PREFIX=/api

# --- Database ------------------------------------------------------------
# SQLite (default) or Postgres, e.g.
#   postgresql+psycopg://football:football@localhost:5432/football
# FA_DATABASE_URL=sqlite:///./data/football_analyst.db
FA_SQL_ECHO=false

# --- HTTP client (politeness) -------------------------------------------
FA_HTTP_TIMEOUT_SECONDS=20
FA_HTTP_MAX_RETRIES=3
# Requests/minute per host. Set to 8-10 for the API-Football Free plan (10/min).
FA_HTTP_RATE_LIMIT_PER_MINUTE=30

# --- Data providers ------------------------------------------------------
# Only the providers listed here are used. Options:
#   football_data_co_uk  reads CSVs YOU downloaded into data/raw (manual, no scraping)
#   manual               reads data/raw/manual_*.json you maintain yourself
#   openfootball         reads PUBLIC-DOMAIN results JSON (no key) over HTTPS
#   sample               SYNTHETIC demo data, clearly labelled (never shown as real)
#   api_football         needs FA_API_FOOTBALL_KEY
#   sportmonks           needs FA_SPORTMONKS_TOKEN
#   football_data_org    needs FA_FOOTBALL_DATA_ORG_KEY
FA_ENABLED_PROVIDERS=football_data_co_uk,manual,openfootball

# openfootball: free public-domain fixtures/results, no key required.
# Configure which competitions and seasons to read, then run:
#   python -m app.cli ingest openfootball
# Codes: en.1 Premier League, es.1 La Liga, de.1 Bundesliga, it.1 Serie A,
#        fr.1 Ligue 1, nl.1 Eredivisie, pt.1 Primeira Liga, uefa.cl, and more.
# Seasons use the European "2024-25" folder style.
FA_OPENFOOTBALL_BASE_URL=https://raw.githubusercontent.com/openfootball/football.json/master
FA_OPENFOOTBALL_LEAGUES=en.1,es.1,de.1,it.1,fr.1
FA_OPENFOOTBALL_SEASONS=2024-25,2025-26,2026-27

# API keys (leave blank to keep the provider disabled).
FA_API_FOOTBALL_KEY=
FA_API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
FA_SPORTMONKS_TOKEN=
FA_FOOTBALL_DATA_ORG_KEY=

# Which provider serves live scores / upcoming fixtures (blank = auto-pick the
# first available of api_football, football_data_org, sportmonks).
FA_LIVE_PROVIDER=

# Opt-in HTML scraping. OFF by default; when enabled robots.txt is honoured and
# only pages the site allows are fetched. See README for the legal notes.
FA_ENABLE_BESOCCER_SCRAPING=false
FA_RESPECT_ROBOTS_TXT=true

# --- Models --------------------------------------------------------------
FA_MONTE_CARLO_SIMULATIONS=10000
FA_TIME_DECAY_HALFLIFE_DAYS=365
FA_MIN_MATCHES_FOR_MODEL=20
FA_MAX_GOALS_GRID=12
# Fit a recent-form (points-per-game) term. Left off: a walk-forward backtest
# found it slightly worse than the form-free model, so it is opt-in for
# experiments, not a default.
FA_MODEL_USE_FORM=false
FA_FORM_WINDOW=5

# --- Prediction bot ------------------------------------------------------
FA_BOT_DEFAULT_DAYS_AHEAD=14
FA_BOT_DEFAULT_LIMIT=50
FA_BOT_LOOP_SECONDS=3600

# --- Ask Sky chat --------------------------------------------------------
# Optional. The chat is always grounded in the model's own output; with a key
# set, an OpenAI-compatible endpoint only rewrites those same facts into
# sentences (it never supplies numbers). Leave FA_LLM_API_KEY blank to use the
# built-in composer.
#
# To enable it for free, paste a free API key and pick a provider -- no install
# and no other settings needed (base URL and model fall back to that provider's
# free-tier defaults). Keys:  groq.com  |  aistudio.google.com  |  openrouter.ai
FA_LLM_API_KEY=
FA_LLM_PROVIDER=groq
# Optional overrides; blank = use the provider's default model/endpoint above.
FA_LLM_BASE_URL=
FA_LLM_MODEL=
FA_LLM_TIMEOUT_SECONDS=20

# --- CORS (frontend origins allowed to call the API) ---------------------
FA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

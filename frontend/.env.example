# Frontend configuration. Copy to `.env` in `frontend/` if you need to override.
# In development the Vite dev server proxies /api to http://127.0.0.1:8000, so
# you normally do NOT need this file.

# Base path of the backend API. Default: "/api" (proxied in dev).
# Set to the full URL when serving the built app from a different origin, e.g.
# VITE_API_BASE=http://127.0.0.1:8000/api
VITE_API_BASE=/api
